# NutriMind — Environment Variables
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# Then load with: python-dotenv or export manually.
# ─────────────────────────────────────────────────

# ── IBM watsonx.ai ────────────────────────────────
WATSONX_APIKEY=your-watsonx-api-key-here
WATSONX_URL=https://au-syd.ml.cloud.ibm.com
WATSONX_PROJECT_ID=your-watsonx-project-id-here

# ── IBM Cloudant ──────────────────────────────────
CLOUDANT_URL=https://your-instance.cloudantnosqldb.appdomain.cloud
CLOUDANT_APIKEY=your-cloudant-apikey-here

# ── IBM Cloud Object Storage ──────────────────────
COS_APIKEY=your-cos-apikey-here
COS_INSTANCE_CRN=crn:v1:bluemix:public:cloud-object-storage:global:a/YOUR_ACCOUNT_ID:YOUR_INSTANCE_ID::
COS_ENDPOINT=https://s3.au-syd.cloud-object-storage.appdomain.cloud

# ── IBM Watson Speech to Text (optional) ──────────
STT_APIKEY=your-stt-apikey-here
STT_URL=https://api.au-syd.speech-to-text.watson.cloud.ibm.com

# ── watsonx Orchestrate (live deployment) ─────────
ORCHESTRATE_HOST=https://au-syd.watson-orchestrate.cloud.ibm.com
ORCHESTRATE_AGENT_ID=c7225708-c2da-45be-a606-2f9037b55bec

# ── MCP Server ────────────────────────────────────
MCP_SERVER_URL=http://localhost:8080/mcp
MCP_SERVER_API_KEY=change-me-to-a-random-secret

# ── USDA FoodData Central ─────────────────────────
# Free key at: https://fdc.nal.usda.gov/api-guide.html
# Leave as DEMO_KEY for testing (rate-limited to 30 req/hour/IP)
USDA_API_KEY=DEMO_KEY
